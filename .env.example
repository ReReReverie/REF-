# Optional: permanent custom-domain origin used for canonical URLs and SEO.
# Leave empty on Vercel until a custom domain is ready.
# Example: https://ref.example
SITE_URL=

# Optional: GA4 loads only after the visitor accepts analytics consent.
# Example: G-ABC1234567
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: token supplied by Google Search Console's HTML tag verification.
GOOGLE_SITE_VERIFICATION=
